-# Search-driven Entity Graph tab. Pick a class within this ontology and its
-# entity graph loads into the concept_entity_graph frame (the same graph the
-# Classes tab shows), rendered client-side by the concept-graph controller.
.ontology-graph-section
  .ontology-graph-section__search
    #qsearch.input-group
      %span.input-group-text
        = inline_svg_tag 'icons/search.svg', class: 'svg-icon'
      = text_field_tag('search_box', nil,
        class: 'form-control rounded-end',
        placeholder: t('ontologies.sections.graph_search_placeholder', default: 'Search for a class to graph…'),
        autocomplete: 'off',
        aria: { label: t('ontologies.sections.graph_search_placeholder', default: 'Search for a class to graph') },
        data: { controller: 'graph-search',
          'graph-search-object-types-value': 'class',
          'graph-search-ontology-acronym-value': @ontology.acronym,
          'graph-search-lang-value': request_lang,
          'graph-search-submission-lang-value': submission_languages,
          'graph-search-portal-lang-value': portal_lang })
    = hidden_field_tag('jump_to_concept_id')

  -# The graph frame. Empty until a class is chosen; the graph-search controller
  -# sets its src to /ajax/entity_graph on selection. The busy overlay is a sibling
  -# (not inside the frame, which swaps its whole content) and is shown by CSS while
  -# the frame is fetching (Turbo sets [busy] on the frame during a load).
  .ontology-graph-section__frame
    = turbo_frame_tag 'concept_entity_graph' do
      .ontology-graph-section__prompt.text-center.py-5.text-muted
        = inline_svg_tag 'icons/search.svg', class: 'svg-icon mb-2', style: 'width:28px;height:28px;opacity:.5'
        %p.mb-0
          Search for a class above to see its entity graph.
    .ontology-graph-section__loading
      = image_tag('spinners/spinner_000000_16px.gif', style: 'vertical-align:text-bottom')
      %span.ms-2 Loading graph…
