= turbo_frame_tag :cookie_notice do
  %div{class: 'cookie-banner shadow rounded p-5'}
    %div
      = t('.message.html', cookies: Rails.configuration.settings.dig(:links, :cookies))
    %div{class: 'd-flex justify-content-end'}
      = button_to('OK', cookie_notice_acknowledge_path, method: 'post', class: 'btn btn-secondary')
