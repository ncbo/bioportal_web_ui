= turbo_frame_tag :cookie_notice do
  %div{class: 'cookie-banner shadow rounded p-4'}
    %div
      = t('.message.html', cookies: Rails.configuration.settings.dig(:links, :cookies), site: "#{$SITE}")
    %div{class: 'd-flex justify-content-end'}
      = button_to('OK', cookie_notice_acknowledge_path, method: 'post', class: 'btn btn-primary')
